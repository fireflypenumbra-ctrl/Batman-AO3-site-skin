#outer {
  background: #202a2e;
}

#main a {
  color: #e6d139;
}

#main {
  color: #fceb9f;
}

#header {
  background: url("https://64.media.tumblr.com/27ecf26217aa4f7c2ac5cae24c9b96df/8091ee82d20c5cb2-4d/s1280x1920/b5731affb7fd12b494b21e519f51caa9217577b9.jpg");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: bottom center;
}

#header .heading {
  height: 20em;
}

#header .heading sup {
  visibility: hidden;
}

#header h1.heading a::before {
  margin-left: 1em;
  content: "TO THE BATCAVE!";
  color: #dcae4a;
  text-shadow: 2px 2px 2px #2a2a2a;
}

#header .heading sup::before {
  content: "  🦇🦇";
  font-style: normal;
  visibility: visible;
}

#header h1.heading span {
  display: none;
}

span.unread {
  background: #f9f6ce;
  color: #0d1d1f;
}

.filters .expander {
  background: url("https://64.media.tumblr.com/79c37e1f878e762e9321ea589b68ec44/07e6f03575c34d93-37/s500x750/a81ba91c6db475fc49c6d6e7f65ef88fbfdd6c7a.jpg") left center no-repeat;
  color: #f9f6ce !important;
  font-weight: bold;
}

.actions a,
.actions a:focus,
.actions input:focus,
.action:focus,
.actions button,
.actions li input,
.actions li input[type="submit"],
input[type="submit"],
.actions li label,
ul.navigation.actions li a,
.action:link,
.actions a:link {
  background: #425e50;
  border: 1px solid #f9f6ce;
  color: #f9f6ce;
  box-shadow: 0px 0px 15px #f9f6ce;
  border-radius: 5px;
}

.current,
#dashboard .current {
  background: #f9f6ce !important;
  color: #0d1d1f !important;
  box-shadow: 0px 0px 15px #f9f6ce !important;
  border-radius: 5px;
}

#dashboard.own {
  border-top: 5px solid #f9f6ce;
  border-bottom: 5px solid #f9f6ce;
  box-shadow: 0px 0px 15px #f9f6ce;
}

#footer {
  background: url("https://64.media.tumblr.com/d2b1db81145554c7ae06b53e620827cb/97ad9f3673d4c286-5d/s1280x1920/7b77e67661c76d8779ec4c401e7e9c9b80be4455.jpg");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: top center;
}

#footer .heading,
#footer a {
  text-shadow: 2px 2px 2px #f2d427;
  background: rgba(42, 42, 42, .3);
  color: #f9f6ce;
}

#main .actions a,
#main .actions a:visited,
#main .action,
#main input[type="submit"],
#main .actions label,
form.button_to button,
#header #search .button {
  background: #776a26;
  border: 1px solid #776a26;
  color: #202a2e;
  box-shadow: none;
}

#header input {
  background: #776a26;
  border: 2px solid #776a26;
}

#header #search input:focus,
.actions input:hover,
.actions input {
  color: #202a2e;
}

.search [role="tooltip"] {
  background: #dcae4a;
  border: 1px solid #dcae4a;
  border-radius: 5px;
}

form.search [role="tooltip"] {
  background: #dcae4a;
  border-radius: 5px;
}

#main .actions a:hover,
#main a.current,
.current,
.actions li .current,
#dashboard .current,
#dashboard a:hover {
  background: #e6d139;
  border: 1px solid #e6d139;
  color: #202a2e !important;
  box-shadow: none;
}

#header ul.primary {
  background: #000;
  box-shadow: none;
}

.notice,
.comment_notice,
.kudos_notice,
ul.notes,
.caution,
.error,
.comment_error,
.kudos_error,
.alert.flash,
.LV_invalid,
.alert .userstuff {
  background: #fceb9f;
  border: 2px solid #fceb9f;
  color: #202a2e;
  box-shadow: none;
}

.notice a,
.comment_notice a,
.kudos_notice a,
ul.notes a,
.caution a,
.error a,
.comment_error a,
.kudos_error a,
.alert.flash a,
.LV_invalid a,
.alert .userstuff a {
  color: #dcae4a !important;
}

.splash .favorite li:nth-of-type(odd) a {
  background: #dcae4a;
  color: #202a2e !important;
}

.splash .favorite li a:hover,
.splash .favorite li a:focus {
  background: #e6d139 !important;
  color: #202a2e !important;
}

.splash .module h3 {
  border-bottom: 1px solid #fceb9f;
  color: #fceb9f;
  font-weight: bold;
}

#header .menu,
a.dropdown-toggle {
  background: #dcae4a;
  box-shadow: none;
}

#header .menu {
  width: 20em;
}

#header .dropdown:hover a {
  background: #dcae4a;
}

#header .menu li {
  color: #fece3f;
  border-bottom: none;
}

#header .dropdown a,
#greeting .user > li a {
  color: #202a2e !important;
  text-shadow: 2px 2px 2px #f2d427;
  background: rgba(42, 42, 42, .3);
}

#header .dropdown a:hover,
#header .actions a:hover,
#header .actions a:focus,
#header .actions a:active {
  color: #202a2e !important;
  border: 1px solid #fece3f;
}

fieldset,
fieldset dl dl,
fieldset fieldset fieldset,
fieldset fieldset dl dl,
dd.hideme,
form blockquote.userstuff,
.dynamic form {
  background: rgb(220, 174, 74, 0.5);
  border: 2px solid #fceb9f;
  box-shadow: none;
}

form dl,
.listbox,
fieldset fieldset.listbox,
li.blurb {
  background: #202a2e;
  border: 2px solid #fceb9f;
  box-shadow: none;
}

.listbox .index {
  background: transparent;
  box-shadow: none;
}

div.dynamic {
  background: none;
}
.index .skins .icon,
p.kudos {
  background: url("https://64.media.tumblr.com/63acaa27ed20c8aa0b99b81dd7587b94/6cd5cb932b4c7533-5c/s1280x1920/252fef403dd73d23b586e892e7bbed98160c71f7.png");
  background-size: 55px, 55px;
  border-radius: 5px;
  background-repeat: no-repeat;
}
.comment .icon .visitor,
.tag .primary .icon {
  background: url("https://64.media.tumblr.com/63acaa27ed20c8aa0b99b81dd7587b94/6cd5cb932b4c7533-5c/s1280x1920/252fef403dd73d23b586e892e7bbed98160c71f7.png");
  background-size: 100px, 100px;
}
.resp-sharing-button--twitter,
.resp-sharing-button--tumblr {
  background: #fceb9f !important;
}

a.resp-sharing-button__link,
a.resp-sharing-button__link:hover {
  color: #202a2e !important;
}

li.comment {
  border: 2px solid #fceb9f;
  box-shadow: none;
}

.thread .even,
.unread,
.own {
  background: rgb(220, 174, 74, 0.5) !important;
  border: 2px solid #fceb9f;
}

.comment h4.byline,
.unread h4.byline {
  background: none;
}

a.tag,
a.tag:visited,
a.tag:link {
  display: inline-block;
  padding: 2px 5px;
  margin: 2px 0px;
  border-radius: 5px;
}

.commas li:after {
  content: "";
}

h5.fandoms.heading a.tag {
  background: #202a2e;
  color: #fceb9f !important;
  border: 1px solid #fceb9f;
  border-radius: 5px;
  text-decoration: none;
}

h5.fandoms.heading a.tag:hover {
  background: #fceb9f;
  color: #202a2e !important;
  border: 1px solid #fceb9f;
  border-radius: 5px;
  text-decoration: none;
}

dd.fandom.tags a {
  color: #fceb9f;
}

.tags li.warnings a.tag {
  background: #e6d139;
  border: 1px solid #e6d139;
  color: #202a2e !important;
  font-weight: normal;
}

.tags li.warnings a.tag:hover {
  background: #202a2e;
  border: 1px solid #e6d139;
  color: #e6d139 !important;
  font-weight: normal;
}

.tags li.relationships a.tag {
  background: #dcae4a;
  border: 1px solid #dcae4a;
  color: #202a2e !important;
}

.tags li.relationships a.tag:hover {
  background: #202a2e;
  border: 1px solid #dcae4a;
  color: #dcae4a !important;
}

.tags li.characters a.tag {
  background: #baa223;
  border: 1px solid #baa223;
  color: #202a2e !important;
}

.tags li.characters a.tag:hover {
  background: #202a2e;
  border: 1px solid #baa223;
  color: #baa223 !important;
}

.tags li.freeforms a.tag {
  background: #fceb9f;
  border: 1px solid #fceb9f;
  color: #202a2e !important;
}

.tags li.freeforms a.tag:hover {
  background: #202a2e;
  border: 1px solid #fceb9f;
  color: #fceb9f !important;
}

#dashboard.own {
  border-top: 15px solid #e6d139;
  border-right: 2px solid #e6d139;
  border-bottom: 15px solid #e6d139;
}

table,
th,
.child,
dl.index dd {
  background: none;
  border: none;
}

p.muted.notice {
  display: none;
}
