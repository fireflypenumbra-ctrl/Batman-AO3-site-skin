#outer {
  background: #000000;
}

#main a {
  color: #E9A31F;
}

#main {
  color: #FFF8C0;
}

#header {
  background: url("https://i.postimg.cc/Wb9SKJYg/Untitled2012-20260815195021.jpg");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: bottom center;
}

#header .heading {
  height: 20em;
}

#header .heading sup {
  visibility: hidden;
}

#header h1.heading a::before {
  margin-left: 1em;
  content: "Escape to the Ünternet";
  color: #E9A31F;
}

#header .heading sup::before {
  content: "  🦇🦇";
  font-style: normal;
  visibility: visible;
}

#header h1.heading span {
  display: none;
}

span.unread {
  background: #FCF072;
  color: #4E0102;
}

.filters .expander {
  background: url("https://64.media.tumblr.com/79c37e1f878e762e9321ea589b68ec44/07e6f03575c34d93-37/s500x750/a81ba91c6db475fc49c6d6e7f65ef88fbfdd6c7a.jpg") left center no-repeat;
  color: #FCF072 !important;
  font-weight: bold;
}

.actions a,
.actions a:focus,
.actions input:focus,
.action:focus,
.actions button,
.actions li input,
.actions li input[type="submit"],
input[type="submit"],
.actions li label,
ul.navigation.actions li a,
.action:link,
.actions a:link {
  background: #FCF072;
  border: 3px solid #A92006;
  color: #000000;
  box-shadow: 0px 0px 15px #FF2600;
  border-radius: 5px;
}

.current,
#dashboard .current {
  background: #FCF072 !important;
  color: #4E0102 !important;
  box-shadow: 0px 0px 15px #FCF072 !important;
  border-radius: 5px;
}

#dashboard.own {
  border-top: 5px solid #FCF072;
  border-bottom: 5px solid #FCF072;
  box-shadow: 0px 0px 15px #FCF072;
}

#footer {
  background: url("https://i.postimg.cc/sVjLD7Z0/Untitled2012-20260816015644.jpg");
  background-repeat: no-repeat;
  background-size: cover;
  background-position: top center;
}

#footer .heading,
#footer a {
  text-shadow: 5px 5px 5px #92A0C2;
  background: rgba(42, 42, 42, .3);
  color: #FCF072;
}

#main .actions a,
#main .actions a:visited,
#main .action,
#main input[type="submit"],
#main .actions label,
form.button_to button,
#header #search .button {
  background: #FFF8C0;
  border: 1px solid #FFF8C0;
  color: #000000;
  box-shadow: none;
}

#header input {
  background: #FFF8C0;
  border: 2px solid #FFF8C0;
}

#header #search input:focus,
.actions input:hover,
.actions input {
  color: #000000;
}

.search [role="tooltip"] {
  background: #E9A31F;
  border: 5px solid #A92006;
  border-radius: 5px;
}

form.search [role="tooltip"] {
  background: #E9A31F;
  border-radius: 5px;
}

#main .actions a:hover,
#main a.current,
.current,
.actions li .current,
#dashboard .current,
#dashboard a:hover {
  background: #A92006;
  border: 3px solid #E9A31F;
  color: #000000 !important;
  box-shadow: none;
}

#header ul.primary {
  background: #780500;
  box-shadow: none;
}

.notice,
.comment_notice,
.kudos_notice,
ul.notes,
.caution,
.error,
.comment_error,
.kudos_error,
.alert.flash,
.LV_invalid,
.alert .userstuff {
  background: #FFF8C0;
  border: 2px solid #FFF8C0;
  color: #000000;
  box-shadow: none;
}

.notice a,
.comment_notice a,
.kudos_notice a,
ul.notes a,
.caution a,
.error a,
.comment_error a,
.kudos_error a,
.alert.flash a,
.LV_invalid a,
.alert .userstuff a {
  color: #A92006 !important;
}

.splash .favorite li:nth-of-type(odd) a {
  background: #E9A31F;
  color: #000000 !important;
}

.splash .favorite li a:hover,
.splash .favorite li a:focus {
  background: #E9A31F !important;
  color: #000000 !important;
}

.splash .module h3 {
  border-bottom: 1px solid #FFF8C0;
  color: #FFF8C0;
  font-weight: bold;
}

#header .menu,
a.dropdown-toggle {
  background: #E9A31F;
  box-shadow: none;
}

#header .menu {
  width: 20em;
}

#header .dropdown:hover a {
  background: #A92006;
}

#header .menu li {
  color: #780500;
  border-bottom: none;
}

#header .dropdown a,
#greeting .user > li a {
  color: #FCF072 !important;
  text-shadow: 5px 5px 5px #FCF072;
}

#header .dropdown a:hover,
#header .actions a:hover,
#header .actions a:focus,
#header .actions a:active {
  color: #FCF072 !important;
  border: 3px solid #E9A31F;
}

fieldset,
fieldset dl dl,
fieldset fieldset fieldset,
fieldset fieldset dl dl,
dd.hideme,
form blockquote.userstuff,
.dynamic form {
  background: #A92006;
  border: 4px solid #E9A31F;
  box-shadow: none;
}

form dl,
.listbox,
fieldset fieldset.listbox,
li.blurb {
  background: #000000;
  border: 2px solid #FFF8C0;
  box-shadow: none;
}

.listbox .index {
  background: transparent;
  box-shadow: none;
}

div.dynamic {
  background: none;
}

.index .skins .icon,
p.kudos {
  background: url("https://i.postimg.cc/Gm5vCWDL/Untitled2015-20260815233557.jpg");
  background-size: 55px, 55px;
  border-radius: 5px;
  background-repeat: no-repeat;
}

.comment .icon .visitor,
.tag .primary .icon {
  background: url("https://i.postimg.cc/C1j8bdQ8/Untitled2013-20260815233649.jpg");
  background-size: 100px, 100px;
}

.resp-sharing-button--twitter,
.resp-sharing-button--tumblr {
  background: #FFF8C0 !important;
}

a.resp-sharing-button__link,
a.resp-sharing-button__link:hover {
  color: #000000 !important;
}

li.comment {
  border: 2px solid #FFF8C0;
  box-shadow: none;
}

.thread .even,
.unread,
.own {
  background: #FFDA96 !important;
  border: 2px solid #A92006;
  color: #000000;
}

.comment h4.byline,
.unread h4.byline {
  background: none;
}

a.tag,
a.tag:visited,
a.tag:link {
  display: inline-block;
  padding: 2px 5px;
  margin: 2px 0px;
  border-radius: 5px;
}

.commas li:after {
  content: "";
}

h5.fandoms.heading a.tag {
  background: #000000;
  color: #FFF8C0 !important;
  border: 1px solid #FFF8C0;
  border-radius: 5px;
  text-decoration: none;
}

h5.fandoms.heading a.tag:hover {
  background: #FFF8C0;
  color: #000000 !important;
  border: 1px solid #FFF8C0;
  border-radius: 5px;
  text-decoration: none;
}

dd.fandom.tags a {
  color: #FFF8C0;
}

.tags li.warnings a.tag {
  background: #F83668;
  border: 1px solid #F83668;
  color: #000000 !important;
  font-weight: normal;
}

.tags li.warnings a.tag:hover {
  background: #000000;
  border: 1px solid #E9A31F;
  color: #E9A31F !important;
  font-weight: normal;
}

.tags li.relationships a.tag {
  background: #A92006;
  border: 1px solid #A92006;
  color: #000000 !important;
}

.tags li.relationships a.tag:hover {
  background: #000000;
  border: 1px solid #FF2600;
  color: #FF2600 !important;
}

.tags li.characters a.tag {
  background: #E9A31F;
  border: 1px solid #E9A31F;
  color: #000000 !important;
}

.tags li.characters a.tag:hover {
  background: #000000;
  border: 1px solid #E9A31F;
  color: #E9A31F !important;
}

.tags li.freeforms a.tag {
  background: #FCF072;
  border: 1px solid #FCF072;
  color: #000000 !important;
}

.tags li.freeforms a.tag:hover {
  background: #000000;
  border: 1px solid #FFF8C0;
  color: #FFF8C0 !important;
}

#dashboard.own {
  border-top: 15px solid #E9A31F;
  border-right: 2px solid #E9A31F;
  border-left: 2px solid #E9A31F;
  border-bottom: 15px solid #E9A31F;
}

table,
th,
.child,
dl.index dd {
  background: none;
  border: none;
}

p.muted.notice {
  display: none;
}
